
# CANable Slcan Makefile

######################################
#
# This makefile compiles for the dual channel CANable board 
# from Oleksii which has a 8 MHz quartz
#
# Windows:
# --------
# Run the script Build.cmd in the root directory
#
# Linux:
# ------
# Compile this by typing in the root directory:
# make -s -f Build/Make_G473_Slcan_OleksiiDual
#
#######################################

# TARGET_BOARD and TARGET_MCU: maximum 24 characters!

TARGET_FIRMWARE = Slcan
TARGET_BOARD    = OleksiiDual
TARGET_MCU      = STM32G473

# This board has a 8 MHz quartz.
QUARTZ_FREQU    = 8000000

include Build/GCC_Rules.mk